{
  "name": "vfl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:perfect-run": "node --test test/perfectRunModes.test.js",
    "test:multiplayer": "node --test test/multiplayer.test.js",
    "check": "npm run lint && npm test && npm run build && npx wrangler deploy --dry-run",
    "lint:app": "eslint src/engine/multiplayer.js worker/index.js test/perfectRunModes.test.js test/multiplayer.test.js",
    "rive:build": "node scripts/rive-build.js",
    "arena:model": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup -P tools/arena3d/build_arena.py --",
    "pack:model": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup -P tools/pack3d/build_pack.py -- public/assets/pack3d/pack.glb"
  },
  "dependencies": {
    "@rive-app/react-canvas": "4.36.0",
    "@rive-app/react-webgl2": "4.36.0",
    "@rive-app/webgl2": "2.44.0",
    "@tabler/icons-react": "^3.48.0",
    "animejs": "^4.5.0",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "motion": "^12.43.0",
    "pixi.js": "^8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "googleapis": "^174.0.1",
    "vite": "^8.0.12",
    "wrangler": "^4.57.0"
  }
}
