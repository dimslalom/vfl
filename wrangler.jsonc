{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vct-lock-in",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "routes": [
    {
      "pattern": "vctfantasy.dimas.works",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBIES",
        "class_name": "Lobby"
      }
    ]
  },

  // Shared with OpVAL, which owns the schema and migrations (dimslalom/opval). VFL only uses daily_scores.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vfl-daily-scores",
      "database_id": "8bfc8861-0417-46d8-8bd5-e18ef206503b"
    }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby"]
    }
  ]
}
